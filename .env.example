# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and must never be committed.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Loan Document Review
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Database ──────────────────────────────────────────────────────────────────
# Must use the postgresql+asyncpg:// scheme.
# If a local PostgreSQL is running on 5432, map the Docker container to 5435
# in docker-compose.yml and update the port here to match.
DATABASE_URL=postgresql+asyncpg://loan_rag:changeme@localhost:5435/loan_rag

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# These are read by docker-compose.yml — keep in sync with DATABASE_URL.
POSTGRES_USER=loan_rag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=loan_rag

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── LLM (Ollama) ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
